# Copy to .env (never commit .env). All values optional; defaults are portable.
# AWS credentials are read from the standard AWS credential chain (aws configure) or these variables:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-2
# AIVS_DATA_DIR=./data
# AIVS_PROJECTS_DIR=./projects
# AIVS_EFFECTCRAFT_CLI=
# AIVS_FILMCRAFT_CLI=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
